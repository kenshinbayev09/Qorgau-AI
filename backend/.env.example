# Copy to backend/.env and adjust. Secrets live ONLY on the server, never in the mobile app.

# --- models ---
URL_MODEL_PATH=models/url_classifier.joblib
DEEPFAKE_MODEL_DIR=../ml/deepfake/weights/deep-fake-detector-v2

# --- safe network analysis ---
NETWORK_CHECKS_ENABLED=true
FETCH_TOTAL_TIMEOUT_S=8
FETCH_MAX_REDIRECTS=5

# --- media limits & isolation ---
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=60
MAX_VIDEO_FRAMES=16
MAX_IMAGE_PIXELS=40000000
MEDIA_TIMEOUT_S=90
MEDIA_ISOLATION=process          # process | inline (inline only for debugging)
MEDIA_WORKER_MEMORY_MB=3072      # RLIMIT_AS for the worker (Linux/macOS only)
TORCH_THREADS=2

# --- optional external services (leave empty to disable) ---
# If set, checked URLs are sent to Google Safe Browsing (v4 Lookup API).
GOOGLE_SAFE_BROWSING_API_KEY=
# If set, the assistant can paraphrase sanitised results with Claude.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- HTTP ---
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60

# --- VirusTotal (проверка файлов). Пусто = выключено. Ключ с https://www.virustotal.com ---
VIRUSTOTAL_API_KEY=
