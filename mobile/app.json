{
  "expo": {
    "name": "Qorgau AI",
    "slug": "qorgau-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.qorgau.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kz.qorgau.ai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Qorgau AI использует камеру только для распознавания QR-кодов на устройстве.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Qorgau AI открывает выбранное вами фото или видео для проверки на признаки дипфейка.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "qorgau",
    "backgroundColor": "#0B1020",
    "experiments": {
      "typedRoutes": false
    }
  }
}
